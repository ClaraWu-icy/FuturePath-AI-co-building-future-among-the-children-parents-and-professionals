# FuturePath AI — 环境变量示例
# 全部可选。不配置 = 本地演示模式（内置规则引擎，不调用真实模型）。

# 服务
PORT=4310
HOST=127.0.0.1
# 生产环境必须改成随机长字符串
AUTH_SECRET=change-me-to-a-long-random-string
# 数据目录（测试时可用临时目录）
DATA_DIR=./data

# AI（可选）：配置后将自动从 simulated 切换为 openai 兼容接口
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=20000
